# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/repomind

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# GitHub API (create a token at https://github.com/settings/tokens - "public_repo" scope is enough)
GITHUB_TOKEN=

# GenAI - Gemini (get a key at https://aistudio.google.com/apikey)
# If left empty, the app runs in "offline mode": deterministic local embeddings
# (TF-IDF) and extractive summaries are used instead, so the app is still fully
# demoable without a paid key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Analysis limits
MAX_COMMITS_TO_ANALYZE=500
MAX_FILES_TO_SCAN=2000
